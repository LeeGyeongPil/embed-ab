# embed-ab needs no keys for the offline demo or the mock/st/ollama providers.
# Only the optional OpenAI-compatible provider ("openai:<model>") reads these.
# A local OpenAI-compatible server usually needs no key.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Optional overrides
# OLLAMA_HOST=http://localhost:11434
# EMBED_AB_CACHE_DIR=~/.cache/embed-ab
# Hugging Face downloads on locked-down macOS / corporate networks:
# SSL_CERT_FILE=/etc/ssl/cert.pem
# HF_HUB_DISABLE_XET=1
# HF_HUB_OFFLINE=1
# Language of messages and reports: en or ko (--lang beats this; otherwise LC_ALL, LC_MESSAGES, LANG decide)
# EMBED_AB_LANG=en
